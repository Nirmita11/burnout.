# Copy to .env for local Postgres testing, or set these directly in
# Render's dashboard for the deployed app. Neither is needed for normal
# local dev — leave DATABASE_URL unset and the app uses burnout.db (SQLite).

# Supabase → Project Settings → Database → Connection string → URI
# (use the "Session pooler" URI, port 6543, not the direct 5432 one —
# Render's free plan doesn't support the persistent connections the
# direct one expects)
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres

# Any long random string — Render can auto-generate this for you
SESSION_SECRET=change-this-to-something-random
